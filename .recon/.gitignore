# Scratch this job produces: log dumps, probe scripts, commit messages, gate logs.
# The two files the recon notes name as the playbook (`_dump.mjs`, `_fidelity-probe.yml`)
# live here too; they stay on disk but out of `git status`, which is what kept 85 files in
# every diff.
_*
check-*.log
commit-*.txt
*.log

# Binaries, captures, session dumps, and scratch builds: the notes (*.md), the
# evidence/ screenshots, and the reusable scripts are what this folder keeps.
*.asar
*.asar.*
app.asar.*
install-backups/
install-staging/
test-install/
build-scratch/
asar-extract/
tidy/
session*.jsonl
*.png
!evidence/*.png
*.log.txt
*.out.txt
*.err.txt
*.bak
probe-*
leak-records.json
spill_*
postfix-cases.json
measure.json
patched-desktop-host.js

# Live protocol captures and the Chrome profile used for them (large, contains a session)
dsw-live/
