{
  "_comment": [
    "Declarative configuration for the local-overlay mod layer.",
    "patchGroups: ordered, first-match-wins. Every Tier-2 path must match exactly one group.",
    "generated: paths regenerated by a generator, never patched and never hand-merged.",
    "tier1Prefixes: paths upstream does not own; carried from fork history, never patched."
  ],
  "patchGroups": [
    {
      "name": "root-meta",
      "paths": [
        ".gitattributes",
        ".gitignore",
        "README.md",
        "README.zh.md",
        "README.i18n.yaml",
        ".claude/",
        "package.json"
      ]
    },
    {
      "name": "tsconfig",
      "paths": [
        "tsconfig.host.json",
        "tsconfig.client.json"
      ]
    },
    {
      "name": "build",
      "paths": [
        "tsdown.config.ts",
        "scripts/"
      ]
    },
    {
      "name": "apps",
      "paths": [
        "apps/"
      ]
    },
    {
      "name": "bundle",
      "paths": [
        "packages/bundle/"
      ]
    },
    {
      "name": "presets",
      "paths": [
        "packages/preset/"
      ]
    },
    {
      "name": "boot",
      "paths": [
        "packages/boot/"
      ]
    },
    {
      "name": "core",
      "paths": [
        "packages/core/"
      ]
    },
    {
      "name": "llm",
      "paths": [
        "packages/llm/"
      ]
    },
    {
      "name": "compaction",
      "paths": [
        "packages/compaction/"
      ]
    },
    {
      "name": "extensions",
      "paths": [
        "packages/extensions/"
      ]
    },
    {
      "name": "skill",
      "paths": [
        "packages/skill/"
      ]
    },
    {
      "name": "client-locale",
      "paths": [
        "packages/client/locale/"
      ]
    },
    {
      "name": "client-chat",
      "paths": [
        "packages/client/ui-chat/"
      ]
    },
    {
      "name": "client-input-trigger",
      "paths": [
        "packages/client/ui-input-trigger/"
      ]
    },
    {
      "name": "client-model-selection",
      "paths": [
        "packages/client/ui-model-selection/"
      ]
    },
    {
      "name": "client-primitives",
      "paths": [
        "packages/client/ui-primitives/"
      ]
    },
    {
      "name": "client-settings",
      "paths": [
        "packages/client/ui-settings-general/",
        "packages/client/ui-settings/"
      ]
    },
    {
      "name": "client-shell",
      "paths": [
        "packages/client/ui-conversation/",
        "packages/client/ui-sidebar/",
        "packages/client/ui-skill/",
        "packages/client/ui-theme/",
        "packages/client/ui-tool/"
      ]
    },
    {
      "name": "session-format-migration",
      "paths": [
        "packages/session/session-format-v0-to-v1/"
      ]
    },
    {
      "name": "docs",
      "paths": [
        "docs/"
      ]
    },
    {
      "name": "agent-skills",
      "paths": [
        ".agents/skills/dsh-code-review/",
        ".agents/skills/dsh-pre-push-checks/"
      ]
    }
  ],
  "generated": [
    {
      "path": "pnpm-lock.yaml",
      "regenerate": "pnpm install --no-frozen-lockfile"
    },
    {
      "path": "tsconfig.base.json",
      "regenerate": "pnpm run gen-tsconfig-paths"
    },
    {
      "path": "docs/config-catalog.md",
      "regenerate": "pnpm run gen-config-catalog"
    },
    {
      "path": "docs/tool-catalog.md",
      "regenerate": "pnpm run gen-tool-catalog"
    },
    {
      "path": "apps/cli/composition.md",
      "regenerate": "pnpm run gen-doc-graphs"
    },
    {
      "path": "docs/capability-seams.md",
      "regenerate": "pnpm run gen-doc-graphs"
    },
    {
      "path": "docs/module-graph.md",
      "regenerate": "pnpm run gen-module-graph"
    },
    {
      "path": "docs/module-graph.zh.md",
      "regenerate": "pnpm run gen-module-graph"
    },
    {
      "path": "docs/module-graph.i18n.yaml",
      "regenerate": "pnpm run gen-module-graph"
    },
    {
      "path": "docs/subsystems/code-runtime.md",
      "regenerate": "pnpm run gen-cordis-catalog"
    },
    {
      "path": "docs/subsystems/code-runtime.zh.md",
      "regenerate": "pnpm run gen-cordis-catalog"
    },
    {
      "path": "docs/subsystems/code-runtime.i18n.yaml",
      "regenerate": "pnpm run gen-cordis-catalog"
    },
    {
      "path": "THIRD_PARTY_NOTICES.md",
      "regenerate": "pnpm run gen-third-party-notices"
    },
    {
      "path": "snapshots/web/lifecycle-chrome/hero.expected.md",
      "regenerate": "pnpm run test:snapshot:record"
    },
    {
      "path": "snapshots/web/lifecycle-chrome/plan-active.expected.md",
      "regenerate": "pnpm run test:snapshot:record"
    }
  ],
  "tier1Prefixes": [
    ".agents/",
    ".merge-port/",
    "local-overlay/",
    "desktop/",
    "python/kiln/",
    "packages/kernel/",
    "packages/llm/llm-kiln/",
    "packages/web/web-browser/",
    "packages/host/sidebar-bridge/",
    "packages/client/ui-sidebar-terminal/",
    "packages/client/ui-effects/",
    "packages/session/command-session-info/",
    "packages/agent-memory/",
    "packages/rlm/",
    "packages/fs/tool-notebook-edit/",
    "start.cmd",
    "start.sh",
    "install.sh",
    "install.ps1",
    "upload_to_git.py",
    "HARNESS-EDITS.md",
    "AI_BIG_PROJECT_DESIGN.md"
  ]
}
