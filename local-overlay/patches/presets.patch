-  disabled: !!js process.platform !== 'win32'
+  disabled: !!js process.platform !== 'win32' || (typeof dshSettingFlag === 'function' && dshSettingFlag('kernel.enabled', true))
+
+# ── the kernel ──────────────────────────────────────────────────────────────
+
+# The model-facing tool only. The kernel SEAM and its Python backend stay on the
+# host plane: the backend owns one interpreter probe and one child process, and
+# an entry-local realm here would mean a second interpreter resolution — and a
+# second kernel — for every preset a session mounts. What a preset chooses is
