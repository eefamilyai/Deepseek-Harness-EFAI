+# gate, because the RLM engine requires the kernel seam: RLM-on implies the REPL
+# is the sole acting surface, while kernel-off cleanly restores the shell roster.
+# EXIT: move these gates and the switch rows into a fork-owned
+# `packages/bundle/efai-rlm/cordis.patch.yml`, applied by profile, once that
+# bundle chain exists (see HARNESS-EDITS.md seam register).
+- id: tool-kernel
+  name: '@deepseek-ai/dsh-tool-kernel'
+  disabled: !!js (typeof dshSettingFlag === 'function' && dshSettingFlag('kernel.enabled', true) && !dshSettingFlag('rlm.enabled', false)) === false
+  config:
+    timeoutMs: 180000
 
