+    let dirty = false
+    try {
+      dirty = execFileSync('git', ['-C', SOURCE_ROOT, 'status', '--porcelain'], { encoding: 'utf8' }).trim() !== ''
+    } catch {
+      // Unreadable status is not a version failure; report clean rather than losing the hash.
+    }
+    return { commit, short: commit.slice(0, 7), dirty }
+  } catch {
+    return unknown
+  }
+}
