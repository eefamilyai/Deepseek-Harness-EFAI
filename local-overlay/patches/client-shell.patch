+/* DSH-FORK(brand): fork edit on an upstream-owned file. EXIT: a fork-owned client package owns this row chrome. */
+/* Family accent (--dsw-alias-flow-*, design-platform.css): the leading glyph,
+   the title, and the separator dot carry one hue per row family, so a scrolled
+   transcript indexes by colour. The summary keeps its neutral tone — it is the
+   row's content, not its kind. Write and edit share the mutate hue: they are one
+   family, already drawn with one icon. `--dsh-row-accent` binds on `.row`, not
+   `.root`, because subcalls render as nested rows under the same `.root` and
+   would inherit their parent's hue; DisclosureRow owns both the rebinding
+   contract and the row TEXT colour that reads this token, so no tool sheet
+   restates a colour for `.title` or `.leading`. */
+.root[data-variant='search'] .row {
+  --dsh-row-accent: var(--dsw-alias-flow-search);
+}
+
+.root[data-variant='read'] .row {
+  --dsh-row-accent: var(--dsw-alias-flow-read);
+}
+
+.root[data-variant='write'] .row,
+.root[data-variant='edit'] .row {
+  --dsh-row-accent: var(--dsw-alias-flow-mutate);
+}
+
+.root[data-variant='bash'] .row {
+  --dsh-row-accent: var(--dsw-alias-flow-shell);
+}
+
+.root[data-variant='code'] .row {
+  --dsh-row-accent: var(--dsw-alias-flow-code);
+}
+
+/* Unclassified calls are still calls, and they are common enough here (goal and
+   preset tools both land on this variant) that leaving them grey put the busiest
+   rows outside the index. */
+.root[data-variant='others'] .row {
+  --dsh-row-accent: var(--dsw-alias-flow-generic);
+}
+
+/* Cordis lifecycle tools retain their generic row mechanics while carrying a
+   shared product accent and tool-owned action title. Tool-scoped, so it must
+   follow the variant rules it overrides — both are one class plus one attribute
+   plus one class, and the cascade resolves the tie by order. */
+.root[data-tool^='cordis_'] .row {
+  --dsh-row-accent: var(--dsw-alias-state-business-primary);
+}
+
 .root {
   display: flex;
   flex-direction: column;
