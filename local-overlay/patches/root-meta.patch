diff --git a/.gitattributes b/.gitattributes
index e0a432111d..6c1da5883e 100644
--- a/.gitattributes
+++ b/.gitattributes
@@ -6,6 +6,11 @@
 # in-repo form stays LF; CRLF becomes checkout-time presentation only.
 * text=auto eol=lf
 
+# cmd.exe misparses batch files with LF line endings (multi-line if/for blocks
+# break into gibberish). The in-repo form stays LF; checkout presents CRLF.
+*.cmd text eol=crlf
+*.bat text eol=crlf
+
 *.pdf binary
 
 # Pairing records are generated from the three confirmed owner-blob pairs.
