{
  "name": "@deepseek-ai/dsh-efai-web",
  "description": "The fork's rows for the browser profile as a bundle: the /version route, the effects and accent layers, and the Tools and Accounts settings sections",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/efai-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-ai-accounts": "workspace:*",
    "@deepseek-ai/dsh-client-ui-brand-efai": "workspace:*",
    "@deepseek-ai/dsh-client-ui-effects": "workspace:*",
    "@deepseek-ai/dsh-client-ui-flow-accents": "workspace:*",
    "@deepseek-ai/dsh-client-ui-model-visibility": "workspace:*",
    "@deepseek-ai/dsh-client-ui-peak-hours": "workspace:*",
    "@deepseek-ai/dsh-client-ui-personalization": "workspace:*",
    "@deepseek-ai/dsh-client-ui-polish": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-accounts": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-tools": "workspace:*",
    "@deepseek-ai/dsh-client-ui-skill-mention": "workspace:*",
    "@deepseek-ai/dsh-host-version-route": "workspace:*",
    "@deepseek-ai/dsh-profile-hub": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
