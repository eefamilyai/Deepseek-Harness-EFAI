{
  "name": "@deepseek-ai/dsh-kernel-python",
  "description": "Kiln-backed persistent Python kernel provider for the DeepSeek Harness kernel seam (ctx.kernel)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/kernel/kernel-python"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "kiln/**"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-kernel": "workspace:*",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-kernel": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*"
  },
  "scripts": {
    "prepack": "node scripts/pack-kiln.mjs"
  }
}
