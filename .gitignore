# Runtime state that can hold live session tokens

python/kiln/runtime/ds_sessions.json

# Per-machine browser identity (seed for device_id + WAF fingerprint). It is
# state, not configuration: committing it would give every machine the same
# device identity, which is the opposite of what it is for.
python/kiln/runtime/ds_identity.json

python/kiln/runtime/subkernels.json

python/kiln/runtime/.kiln_memory/


# vision_tools captures: these are pictures of the real screen, so they must
# never reach a commit. Written under KILN_STATE_DIR when set, else beside the
# runtime; both locations are covered.
python/kiln/runtime/screenshots/
screenshots/


# Harness desktop shell: CDP discovery record, regenerated at every launch
.cdp-target.json
